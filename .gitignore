.DS_Store
node_modules/
dist/
*.log

# Yarn 4 (nodeLinker: node-modules) — keep the lockfile, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/versions
.pnp.*

# Python bytecode
__pycache__/
*.pyc

# Agent git worktrees. These are separate checkouts of this same repo that
# happen to live inside it; committing one would commit a second copy of the
# whole tree. Also ignored by Prettier, for the same reason.
.claude/worktrees/
