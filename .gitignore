.DS_Store
node_modules/
dist/
*.log

# Yarn 4 (nodeLinker: node-modules) — keep the lockfile, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/versions
.pnp.*

# Inputs to the mesh bakes — the .glb a generator handed back, which
# tools/bake-*.ts turns into a source module. These are the one place a binary
# is allowed to sit in this tree, and they must never be committed or shipped:
# what ships is the baked .ts. Keep them, though — re-running a generator does
# not reproduce the same mesh.
genassets/

# Python bytecode
__pycache__/
*.pyc

# Agent git worktrees. These are separate checkouts of this same repo that
# happen to live inside it; committing one would commit a second copy of the
# whole tree. Also ignored by Prettier, for the same reason.
.claude/worktrees/
