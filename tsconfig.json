{
  // Phase 1 of the JS -> TS conversion: permissive settings, so the tree
  // compiles as real TypeScript and we get three.js's types for free, without
  // demanding an annotation pass over 10,000 lines of extracted bundle code.
  // `strict` and `noImplicitAny` are meant to be turned on later, module by
  // module. Do not add annotations just to satisfy a flag that is still off.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    // Vite/esbuild does the transpiling; tsc is only ever a checker here.
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // ES2022 semantics: class fields are DEFINED, not assigned. This matches
    // what the old defineField() shim did (Object.defineProperty, enumerable +
    // configurable + writable), so converting those call sites to real fields
    // preserves behaviour exactly.
    "useDefineForClassFields": true,

    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src"]
}
