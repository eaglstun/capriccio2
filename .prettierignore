# public/ is the pristine downloaded production build — the reference the whole
# reconstruction is verified against. It must stay byte-for-byte as deployed.
# Never format it.
public/

# Build output and vendored tooling.
dist/
node_modules/
.yarn/
yarn.lock

# Agent git worktrees live inside the repo. They are separate checkouts of this
# same tree, so formatting them means formatting everything twice — and a
# worktree mid-edit turns `format:check` (and therefore CI and the pre-commit
# hook) red for work that is not on this branch.
.claude/worktrees/

# Generated by the splitter, not hand-authored.
src/manifest.json
src/renames.json
src/vendor-imports.json

# Hash baseline written by tools/code_fingerprint.py. Data, not source.
tools/.code-fingerprint.json
